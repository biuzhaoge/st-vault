From 01a395b935b9da12dbeca588a7130c4db6a14689 Mon Sep 17 00:00:00 2001
From: Michael Niedermayer <michael@niedermayer.cc>
Date: Tue, 3 Nov 2026 04:28:59 +0100
Subject: [PATCH] avcodec/rawdec: require a full row of input per line for 1 to
 8 bits per pixel

Fixes: Wq9WI8WzfMaj
Fixes: AISLE-2026-0150-00106
Fixes: use of uninitialized memory
Use of uninitialized memory Replicated through UnModified FFmpeg with MSAN

Found-by: Joshua Rogers (AISLE)
---
 libavcodec/rawdec.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/libavcodec/rawdec.c b/libavcodec/rawdec.c
index 53d1fba583968..69df3efcaa365 100644
--- a/libavcodec/rawdec.c
+++ b/libavcodec/rawdec.c
@@ -205,6 +205,12 @@ static int raw_decode(AVCodecContext *avctx, AVFrame *frame,
         (context->is_mono || context->is_pal8) &&
         (!avctx->codec_tag || avctx->codec_tag == MKTAG('r','a','w',' ') ||
                 context->is_nut_mono || context->is_nut_pal8)) {
+        int bits = context->is_mono ? 1 :
+                   avctx->bits_per_coded_sample ? avctx->bits_per_coded_sample : 8;
+        if (stride < ((int64_t)avctx->width * bits + 7) / 8) {
+            av_log(avctx, AV_LOG_ERROR, "Packet too small (%d)\n", avpkt->size);
+            return AVERROR_INVALIDDATA;
+        }
         context->is_1_2_4_8_bpp = 1;
         if (context->is_mono) {
             int row_bytes = avctx->width / 8 + (avctx->width & 7 ? 1 : 0);
